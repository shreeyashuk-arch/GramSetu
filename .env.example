# Database Connection (SQLite zero setup)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Cookies
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Optional: Google Maps JavaScript API Key (leaves blank to use auto-fallback Leaflet + OpenStreetMap)
NEXT_PUBLIC_MAPS_API_KEY=""

# Optional: Chatbot embed URL (leaves blank to use built-in Gram Assistant bot)
NEXT_PUBLIC_CHATBOT_URL=""

# Demo Mode Enabled (One-click login switcher & displayed OTPs)
NEXT_PUBLIC_DEMO_MODE="true"
